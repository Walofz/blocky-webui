{
  "name": "blocky-webui-backend",
  "version": "1.0.0",
  "description": "Blocky management WebUI backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "generate": "ts-node --transpile-only src/generate-blocky-config.ts",
    "test:ingest": "ts-node --transpile-only src/services/__tests__/logIngest.smoke.ts",
    "test:smoke": "ts-node --transpile-only src/__tests__/generate-blocky-config.smoke.ts && ts-node --transpile-only src/services/__tests__/generateService.smoke.ts && ts-node --transpile-only src/services/__tests__/listFileService.smoke.ts && ts-node --transpile-only src/services/__tests__/logIngest.smoke.ts"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  }
}
