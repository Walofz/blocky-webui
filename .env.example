# Optional environment overrides for docker-compose
# Copy this to .env and edit as needed

# URL of your Blocky HTTP API — used by the backend to trigger config reloads.
# When running with docker-compose (Blocky in host network mode), leave this as-is.
# The extra_hosts entry in docker-compose.yml maps host.docker.internal → host on Linux.
BLOCKY_URL=http://host.docker.internal:4000

# Host port to expose the WebUI on (default: 80)
WEBUI_PORT=80

# CORS origin (only needed if accessing the backend directly from a different origin)
CORS_ORIGIN=http://localhost

# Optional token-based auth for WebUI API and log stream.
# Set this to enable authentication on the backend and inject the same token into the frontend build.
WEBUI_AUTH_TOKEN=
